# Copy to .env next to compose.yml and edit.

# Public IP or DNS name clients dial. It goes into every .owcfg.
OUTWARP_ENDPOINT=vpn.example.com

# Public TCP port for the tunnel (and client enrolment). The only port that
# has to be reachable from the internet.
OUTWARP_PORT=443

# Local port for the web panel (bound to 127.0.0.1 on the host).
OUTWARP_PANEL_PORT=9443

# Tunnel subnet: must not overlap your LAN or the clients' networks.
OUTWARP_SUBNET=10.13.13.0/24
OUTWARP_SERVER_ADDRESS=10.13.13.1/24

# Image tag: `latest` follows main; pin a release (e.g. 0.17.0) for production.
OUTWARP_IMAGE_TAG=latest
