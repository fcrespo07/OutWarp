/* OutWarp client TUI tokens — mirrors the Claude Design palette.
 * BMP glyphs only; no emoji, no nerd fonts. */

$brand: #2563ff;
$ok: #2ee0b3;
$warn: #ff9b4a;
$bad: #ff5c7a;
$dim: #6e747e;
$dim2: #4a4f57;
$bright: #f4f5f7;
$bg: #0a0c10;
$bg2: #11141a;

Screen {
    background: $bg;
    color: $bright;
}

Header {
    background: $brand;
    color: white;
}

Footer {
    background: $bg2;
    color: $dim;
}

#root {
    height: 1fr;
}

.status-col {
    width: 50%;
    padding: 1 2;
    /* Allow scrolling so all three cards remain reachable on short
       terminals (24-row windows can't fit StatusCard + TrafficCard +
       TunnelCard at once with chrome + content). */
    overflow-y: auto;
}

.status-col > Container {
    margin-bottom: 1;
    border: tall $dim2;
    padding: 1 2;
    height: auto;
}

.card-title {
    color: $dim;
    text-style: bold;
}

.label {
    color: $dim;
}

.value {
    color: $bright;
    text-style: bold;
}

.value.ok {
    color: $ok;
}

.value.warn {
    color: $warn;
}

.value.bad {
    color: $bad;
}

RichLog#log {
    background: $bg;
    border: tall $dim2;
    padding: 1;
    width: 50%;
}

PhaseRow {
    padding: 0 2;
    height: 1;
}

PhaseRow.done {
    color: $ok;
}

PhaseRow.active {
    color: $brand;
    text-style: bold;
}

PhaseRow.pending {
    color: $dim;
}

Sparkline {
    height: 1;
    color: $ok;
}

#empty-shell {
    align: center middle;
    padding: 2 4;
}

#empty-shell Static {
    content-align: center middle;
    margin-bottom: 1;
}

ModalScreen {
    align: center middle;
}

#import-modal,
#help-modal,
#settings-modal {
    width: 70;
    height: auto;
    background: $bg2;
    border: thick $brand;
    padding: 1 2;
}

#import-modal Input {
    margin-bottom: 1;
}

#settings-modal {
    width: 80;
}

#settings-modal .settings-row {
    height: auto;
    margin: 1 0 0 0;
}

#settings-modal .settings-row Switch {
    margin-right: 2;
    width: 12;
}

#settings-modal .settings-text {
    height: auto;
    width: 1fr;
}

#settings-modal #settings-status {
    margin-top: 1;
}

#fail-banner {
    background: $bad 30%;
    color: $bad;
    padding: 1 2;
    margin: 1 2;
    border: tall $bad;
}

/* ── Profile editor ────────────────────────────────────────────────────── */

#profile-scroll {
    padding: 1 3;
}

.profile-title {
    color: $bright;
    margin-bottom: 0;
}

.profile-subtitle {
    margin-bottom: 1;
}

.profile-row {
    height: auto;
    margin-bottom: 1;
    border: tall $dim2;
    padding: 1 2;
}

.profile-label {
    color: $bright;
}

.profile-hint {
    color: $dim;
    margin-bottom: 1;
}

.profile-input {
    margin-top: 0;
}

.profile-actions {
    height: auto;
    padding: 1 2;
}

#profile-status {
    width: 1fr;
}

.settings-profile-link {
    margin-top: 1;
    padding: 1 2;
    border: tall $brand;
    height: auto;
}
