/* OutWarp server TUI tokens — mirrors ui/styles.css and tui/tokens.py. */

$brand: #2563ff;
$ok: #2ee0b3;
$warn: #ff8a3d;
$bad: #ff4d6d;
$dim: #6e747e;
$dim2: #4a4f57;
$bright: #f4f5f7;
$bg: #0a0c10;
$bg2: #11141a;

Screen {
    background: $bg;
    color: $bright;
}

Header {
    background: $brand;
    color: white;
}

Footer {
    background: $bg2;
    color: $dim;
}

#root {
    height: 1fr;
}

.col {
    width: 50%;
    padding: 1 2;
    /* Scroll so all cards in a column remain reachable on 24-row
       terminals (default Linux tty + most SSH sessions). */
    overflow-y: auto;
}

.col > Container {
    margin-bottom: 1;
    border: tall $dim2;
    padding: 1 2;
    height: auto;
}

.card-title {
    color: $dim;
    text-style: bold;
}

.value { color: $bright; text-style: bold; }
.value.ok { color: $ok; }
.value.warn { color: $warn; }
.value.bad { color: $bad; }

DataTable {
    background: $bg;
}

DataTable > .datatable--header {
    background: $bg2;
    color: $dim;
}

DataTable > .datatable--cursor {
    background: $brand;
    color: white;
}

#clients-shell {
    padding: 1 2;
}

#clients-shell Input {
    margin-bottom: 1;
}

#doctor-shell {
    padding: 1 2;
}

ModalScreen {
    align: center middle;
}

#add-modal,
#confirm-modal,
#revoke-modal,
#qr-modal,
#help-modal {
    width: 80;
    height: auto;
    background: $bg2;
    border: thick $brand;
    padding: 1 2;
}

#qr-modal {
    width: 90;
}

.warn-banner {
    color: $warn;
    text-style: bold;
}

.success { color: $ok; }
.fail { color: $bad; }
.info { color: $dim; }
